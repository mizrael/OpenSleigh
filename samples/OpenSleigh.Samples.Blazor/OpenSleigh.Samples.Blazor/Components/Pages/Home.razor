@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@using OpenSleigh.Samples.Blazor.Hubs 
@inject NavigationManager NavigationManager
@implements IAsyncDisposable
@rendermode InteractiveServer

@if (IsConnected)
{
    @if (isProcessing)
    {
        <pre>processing...</pre>
    }
    else
    {
        <div class="form-inline mb-4">
            <div class="form-group mr-2">
                <label for="stepsCount" class="mr-2">Steps count:</label>
                <input type="number" min="1" @bind="stepsCount" id="stepsCount" />
            </div>
            <button @onclick="StartSaga" >Start!</button>
        </div>
    }

    <ul class="list-group">
        @foreach (var message in messages)
        {
            <li class="list-group-item">[@message.Value.When] @message.Value.Text</li>
        }
    </ul>
}
else
{
    <pre>loading...</pre>
}

@code {
    private HubConnection? hubConnection;
    private SortedList<DateTimeOffset, Notification> messages = new ();
    private bool isProcessing = false;
    private int stepsCount = 1;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/sagahub"))
            .Build();

        hubConnection.On<Notification, bool>("Notification", (notification, isDone) =>
        {
            isProcessing = !isDone;
            messages.Add(notification.When, notification);
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private async Task StartSaga()
    {
        if (hubConnection is null)
            return;

        messages.Clear();
        isProcessing = true;
        StateHasChanged();

        await hubConnection.SendAsync("StartSaga", hubConnection.ConnectionId, stepsCount);
    }

    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }
}
